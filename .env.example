# ===========================================
# THREE MONKEYS - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

NEXT_PUBLIC_SITE_NAME="Three Monkeys"
NEXT_PUBLIC_SITE_URL="https://threemonkeysphuket.com"
NEXT_PUBLIC_APP_URL="https://threemonkeysphuket.com"
WEBSITE_ID="three-monkeys"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_key

# Stripe
STRIPE_SECRET_KEY=your_stripe_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_webhook_secret

# Resend (Email)
RESEND_API_KEY=re_xxxxx
# Verify this domain in Resend before enabling email delivery.
EMAIL_FROM="Three Monkeys Restaurant <enjoy@threemonkeysphuket.com>"
ADMIN_EMAIL=enjoy@threemonkeysphuket.com
CONTACT_EMAIL=enjoy@threemonkeysphuket.com

# Optional: use only the restaurant's own LiveChat license.
NEXT_PUBLIC_LIVECHAT_LICENSE=

# Admin bootstrap is disabled by default. Temporarily enable only for initial setup.
ENABLE_ADMIN_BOOTSTRAP=false
# Supply a random key of at least 32 characters when bootstrap is enabled.
ADMIN_BOOTSTRAP_KEY=

# OneBooking sync
ONEBOOKING_API_URL=https://db.onebooking.co
ONEBOOKING_API_KEY=your_api_key

# Maintenance mode
# When MAINTENANCE_MODE=true, the public website shows the maintenance page
# instead of the homepage. Admin (/admin/*) and API (/api/*) routes are still
# accessible. Visit any URL with ?preview=<PIN> once to set a 30-day bypass
# cookie. Set MAINTENANCE_BYPASS_PIN to any short value (4 digits typical).
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_PIN=0000
